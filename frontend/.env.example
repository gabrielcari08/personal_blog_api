# Base path for the backend API consumed by frontend/src/api/client.js.
# In development, Vite proxies /api to the FastAPI backend (see vite.config.js).
VITE_API_BASE_URL=/api/v1

# Target of the Vite dev-server proxy for /api.
# On the host this is localhost; inside Docker it is overridden by docker-compose
# to point at the "api" service (http://api:8000).
VITE_API_PROXY_TARGET=http://localhost:8000

# Enable polling for file watching. Useful when the source is bind-mounted from
# Windows into a Linux container and HMR does not detect changes.
VITE_USE_POLLING=false
