# Ruta base de la API del backend consumida por frontend/src/api/client.js.
# En desarrollo, Vite redirige /api al backend FastAPI (ver vite.config.js).
VITE_API_BASE_URL=/api/v1

# Destino del proxy del servidor de desarrollo de Vite para /api.
# En el host es localhost; dentro de Docker docker-compose lo sobrescribe para
# apuntar al servicio "api" (http://api:8000).
VITE_API_PROXY_TARGET=http://localhost:8000

# Activa el polling para vigilar los cambios de archivos. Útil cuando el código
# se monta desde Windows en un contenedor Linux y el HMR no detecta los cambios.
VITE_USE_POLLING=false
